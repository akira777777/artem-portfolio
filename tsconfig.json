{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "script.js",
    "api/**/*.js",
    "scripts/**/*.mjs",
    "sites/**/*.js",
    "src/types.d.ts"
  ]
}
